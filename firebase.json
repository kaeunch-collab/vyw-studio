{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "us-central1" } }
    ],
    "headers": [
      {
        "source": "**/*.@(css|jpg|jpeg|png|svg|webp)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/r-xiyedm7aw0l*",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/r-xiyedm7aw0l/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": ["node \"$RESOURCE_DIR/sync-survey-config.js\""]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
